<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <CgOpenGLDependencies Condition="'$(CgOpenGLDependencies)' == ''">$(MSBuildThisFileDirectory).cg-deps</CgOpenGLDependencies>
    <LocalDebuggerWorkingDirectory>$(ProjectDir)</LocalDebuggerWorkingDirectory>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Platform)' == 'x64'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(CgOpenGLDependencies)\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(CgOpenGLDependencies)\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>opengl32.lib;glew32.lib;glfw3dll.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <Target Name="CheckCgOpenGLDependencies" BeforeTargets="PrepareForBuild" Condition="'$(Platform)' == 'x64'">
    <Error Condition="!Exists('$(CgOpenGLDependencies)\include\GL\glm\glm.hpp') Or !Exists('$(CgOpenGLDependencies)\include\GL\glew.h') Or !Exists('$(CgOpenGLDependencies)\include\GL\glfw3.h') Or !Exists('$(CgOpenGLDependencies)\lib\glew32.lib') Or !Exists('$(CgOpenGLDependencies)\lib\glfw3dll.lib') Or !Exists('$(CgOpenGLDependencies)\bin\glew32.dll') Or !Exists('$(CgOpenGLDependencies)\bin\glfw3.dll')" Text="CG_2026 x64 OpenGL dependencies are incomplete at $(CgOpenGLDependencies). See README.md." />
  </Target>
  <Target Name="CopyCgOpenGLRuntime" AfterTargets="Build" Condition="'$(Platform)' == 'x64'">
    <Copy SourceFiles="$(CgOpenGLDependencies)\bin\glew32.dll;$(CgOpenGLDependencies)\bin\glfw3.dll" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
