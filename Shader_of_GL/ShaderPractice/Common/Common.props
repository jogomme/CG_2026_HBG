<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Import once after project-specific settings, before Microsoft.Cpp.targets.
       Paths are anchored to this file, independent of the consuming solution. -->
  <PropertyGroup>
    <OpenGLCommonDirectory>$(MSBuildThisFileDirectory)</OpenGLCommonDirectory>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="$(OpenGLCommonDirectory)Shader.cpp"><Link>Common\Shader.cpp</Link></ClCompile>
    <ClInclude Include="$(OpenGLCommonDirectory)Shader.h"><Link>Common\Shader.h</Link></ClInclude>
    <ClCompile Include="$(OpenGLCommonDirectory)Camera.cpp"><Link>Common\Camera.cpp</Link></ClCompile>
    <ClInclude Include="$(OpenGLCommonDirectory)Camera.h"><Link>Common\Camera.h</Link></ClInclude>
    <ClCompile Include="$(OpenGLCommonDirectory)GLUtils.cpp"><Link>Common\GLUtils.cpp</Link></ClCompile>
    <ClInclude Include="$(OpenGLCommonDirectory)GLUtils.h"><Link>Common\GLUtils.h</Link></ClInclude>
    <ClInclude Include="$(OpenGLCommonDirectory)GLCommon.h"><Link>Common\GLCommon.h</Link></ClInclude>
  </ItemGroup>
</Project>
