<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!--
    OpenGL 3.3 실습 공통 설정

    사용법: 프로젝트 vcxproj에 아래 한 줄만 추가하면 모든 설정이 적용됩니다.
    <ImportGroup Label="PropertySheets">
      <Import Project="..\GL.props" />
    </ImportGroup>

    포함 항목
      - 링커: opengl32.lib / glew32.lib / glfw3dll.lib
      - C++20
      - /utf-8 (한글 주석이 CP949로 오해되어 줄이 병합되는 문제 방지)

    참고: glew32.lib 과 glfw3dll.lib 은 Windows SDK 에 x64 버전만
    존재합니다. 따라서 링커 설정은 x64 에만 적용합니다.
  -->

  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <ConformanceMode>true</ConformanceMode>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Platform)'=='x64'">
    <Link>
      <AdditionalDependencies>opengl32.lib;glew32.lib;glfw3dll.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

</Project>
